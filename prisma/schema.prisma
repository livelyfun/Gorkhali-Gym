datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  name         String
  role         String         @default("admin")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

model SiteSetting {
  id                String   @id @default("global")
  gymName           String   @default("Gorkhali Gym")
  phone             String   @default("+977 982-8405453")
  whatsapp          String   @default("+977 982-8405453")
  address           String   @default("Opposite Soaltee Westend Hotel, Dharan Road, Itahari, Koshi Province 56705, Nepal")
  mapUrl            String   @default("https://maps.app.goo.gl/U8ACjdU8KZUmqsfV9")
  openingHours      String   @default("5:00 AM – 9:00 PM")
  facebookUrl       String   @default("https://www.facebook.com/p/Gorkhali-Fitness-61571983437753/")
  instagramUrl      String   @default("https://www.instagram.com/gorkhali_fitness/")
  tiktokUrl         String   @default("https://www.tiktok.com/@gorkhali.fitness")
  contactEmail      String?
  primaryColor      String   @default("#DC2626")
  secondaryColor    String   @default("#1F2937")
  darkBackground    String   @default("#0B0E14")
  logoUrl           String?
  faviconUrl        String?
  applyButtonLabel  String   @default("Apply Now")
  applyButtonUrl    String   @default("/apply")
  footerDescription String   @default("Premium fitness, discipline, and community in Itahari, Koshi Province.")
  copyrightText     String   @default("© 2026 Gorkhali Gym. All rights reserved.")
  metaTitle         String   @default("Gorkhali Gym | Premier Fitness Club in Itahari, Nepal")
  metaDescription   String   @default("Gorkhali Gym in Itahari, Koshi Province, Nepal. Strength training, personal coaching, yoga, and nutrition.")
  updatedAt         DateTime @updatedAt
}

model AnnouncementBanner {
  id        String    @id @default(cuid())
  text      String
  linkUrl   String?
  linkLabel String?
  isActive  Boolean   @default(false)
  startDate DateTime?
  endDate   DateTime?
  updatedAt DateTime  @updatedAt
}

model PageSection {
  id           String   @id @default(cuid())
  pageSlug     String
  sectionKey   String
  heading      String
  subheading   String?
  bodyText     String?
  imageUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@unique([pageSlug, sectionKey])
}

model NavigationItem {
  id           String           @id @default(cuid())
  label        String
  href         String
  displayOrder Int              @default(0)
  parentId     String?
  parent       NavigationItem?  @relation("NavHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[] @relation("NavHierarchy")
  isPublished  Boolean          @default(true)
}

model Program {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  category     String    // "training" | "service"
  shortDesc    String
  fullDesc     String
  imageUrl     String?
  badge        String?
  duration     String?
  features     String[]
  ctaLabel     String    @default("Apply Now")
  displayOrder Int       @default(0)
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MembershipPlan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  priceInfo    String?
  period       String?
  description  String
  features     String[]
  isFeatured   Boolean  @default(false)
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model ReferralProgram {
  id          String   @id @default(cuid())
  title       String
  benefitText String
  rules       String
  isActive    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Offer {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  badge        String?
  shortDesc    String
  fullDesc     String
  discountInfo String?
  imageUrl     String?
  validUntil   DateTime?
  displayOrder Int       @default(0)
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Event {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  date         DateTime
  location     String
  shortDesc    String
  fullDesc     String
  imageUrl     String?
  displayOrder Int       @default(0)
  isPublished  Boolean   @default(false)
  updatedAt    DateTime  @updatedAt
}

model Trainer {
  id             String   @id @default(cuid())
  name           String
  role           String
  bio            String
  qualifications String[]
  imageUrl       String?
  facebookUrl    String?
  instagramUrl   String?
  whatsappUrl    String?
  email          String?
  displayOrder   Int      @default(0)
  isPublished    Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  caption      String?
  orientation  String   @default("landscape") // "landscape" | "portrait"
  category     String   @default("general")
  imageUrl     String
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Review {
  id           String    @id @default(cuid())
  author       String
  rating       Int       @default(5)
  previewText  String
  fullText     String
  avatarUrl    String?
  reviewDate   DateTime  @default(now())
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  displayOrder Int       @default(0)
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  author      String    @default("Gorkhali Gym")
  category    String    @default("Fitness")
  readTime    String    @default("4 min read")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Faq {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("General")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(false)
}

model Inquiry {
  id            String   @id @default(cuid())
  referenceCode String   @unique
  fullName      String
  phone         String
  email         String?
  goal          String
  preferredTime String?
  message       String?
  selectedOffer String?
  status        String   @default("new")
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String   @unique
  pathname  String
  filename  String
  size      Int
  mimeType  String
  altText   String?
  caption   String?
  createdAt DateTime @default(now())
}

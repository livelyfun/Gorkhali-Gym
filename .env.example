# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Pooled Neon PostgreSQL connection string for runtime queries.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct Neon PostgreSQL connection string for Prisma CLI migrations.
DIRECT_URL="postgresql://user:password@ep-sample-direct.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# BLOB_READ_WRITE_TOKEN: Vercel Blob access token for persistent media storage.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_example"

# ADMIN_SETUP_SECRET: Secret key for one-time production administrator provisioning.
ADMIN_SETUP_SECRET="change-me-to-a-secure-random-token"

# ADMIN_SEED_USERNAME / ADMIN_SEED_PASSWORD: Bootstrap admin credentials.
# Required in production. In local development, if these are unset the app falls
# back to the gitignored credentials.md file in the repository root.
ADMIN_SEED_USERNAME=""
ADMIN_SEED_PASSWORD=""

# ADMIN_SESSION_SECRET: HMAC key used to sign admin session cookies. Set a long
# random value in production so signed sessions stay valid across deploys and
# serverless instances. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=""
